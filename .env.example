# Copy this file to .dev.vars for `wrangler dev`. Never commit real values.
TRIGGER_SECRET=replace-with-a-long-random-secret

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=replace-with-your-supabase-secret

OCI_ADB_US_URL=https://your-us-ords-endpoint.example
OCI_ADB_US_USER=replace-with-your-us-user
OCI_ADB_US_PASS=replace-with-your-us-password

OCI_ADB_JP_URL=https://your-jp-ords-endpoint.example
OCI_ADB_JP_USER=replace-with-your-jp-user
OCI_ADB_JP_PASS=replace-with-your-jp-password

IBMCLOUD_API_KEY=replace-with-your-ibm-cloud-api-key
DB2_DEPLOYMENT_ID=replace-with-your-db2-deployment-id

# Privacy and location behavior
SHOW_FULL_IP=false
USE_REAL_TRACE=false
